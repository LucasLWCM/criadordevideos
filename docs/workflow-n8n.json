    },
    {
      "parameters": {
        "jsCode": "const resposta = $input.first().json;\nif (resposta.status !== 'ok') throw new Error('Erro no render: ' + JSON.stringify(resposta));\n\nconst filename = resposta.arquivo.split('/').pop();\n// IMPORTANTE: substitua SEU_DOMINIO pelo domínio do serviço criadordevideos no EasyPanel\nconst VIDEO_BASE_URL = 'https://SEU_DOMINIO';\nconst videoUrl = `${VIDEO_BASE_URL}/output/${filename}`;\n\nconst montarProps = $('Montar Props').item.json;\n\nreturn [{ json: { videoUrl, caption: montarProps.caption, _rowIndex: montarProps._rowIndex } }];"
      },
