      "parameters": {
        "jsCode": "const rows = $input.all().filter(r => String(r.json.usado).toUpperCase() !== 'TRUE');\nif (rows.length === 0) throw new Error('Nenhuma frase disponível — todas já foram usadas');\nconst idx = Math.floor(Math.random() * rows.length);\nconst row = rows[idx];\nreturn [{ json: { ...row.json, _rowIndex: row.json.row_number } }];"
      },
