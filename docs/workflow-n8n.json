      "typeVersion": 4.2,
      "position": [660, 300],
      "id": "aaaa0007-0000-0000-0000-000000000007",
      "name": "Sortear Assets"
    },
    {
      "parameters": {
        "jsCode": "const frase = $('Sortear Frase').item.json;\nconst assets = $('Sortear Assets').item.json;\nconst variantes = ['A', 'B'];\nconst variante = (frase.variante && ['A','B'].includes(frase.variante))\n  ? frase.variante\n  : variantes[Math.floor(Math.random() * 2)];\n\nconst caption = `\"${frase.frase}\"\\n— ${frase.autor}\\n\\n${frase.caption_extra || 'Comente \"Sementes\" para entrar na nossa comunidade e receber um áudio meu todo dia pela manhã com um pensamento filosófico que te fará voltar a se apaixonar pela vida.'}\\n\\n#filosofia #estoicismo #sabedoria #autoconhecimento #rafabarbosapsicologia`;\n\nreturn [{\n  json: {\n    props: {\n      frase: frase.frase,\n      autor: frase.autor,\n      imagem: assets.imagem,\n      musica: assets.musica,\n      duracao: 8,\n      variante,\n      posicao_frase: 'centro',\n      arroba: 'rafabarbosa.filosofia',\n      avatar: 'avatar.png',\n      tema: frase.tema || 'filosofia',\n    },\n    caption,\n    _rowIndex: frase._rowIndex,\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 300],
      "id": "aaaa0004-0000-0000-0000-000000000004",
      "name": "Montar Props"
